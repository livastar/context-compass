{
  "name": "context-compass",
  "version": "0.1.0",
  "description": "Codex plugin that maps project context, quality signals, and next best actions before implementation.",
  "type": "module",
  "license": "MIT",
  "author": "DS Light / Stanislav Ivanov",
  "homepage": "https://livastar.observer",
  "bin": {
    "context-compass": "dist/src/context-compass.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/livastar/context-compass.git"
  },
  "keywords": [
    "codex",
    "plugin",
    "context",
    "agents",
    "quality"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-plugin-script.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:metadata": "node --import tsx tests/validate-plugin-metadata.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:metadata"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "npm@10.9.2"
}
